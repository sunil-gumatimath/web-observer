.env
.env.local
**/.env
**/.env.local

# Local data, logs and generated artefacts
data
**/data
**/*.log
dump.rdb

# Not needed inside the image
.git
.github
docs
assets
scripts
README.md
pyrightconfig.json
.gitleaks.toml
.gitleaksignore
.neon
