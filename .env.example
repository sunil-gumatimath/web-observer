# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=dev-internal-token

# --- Local (no Docker): use localhost ---
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/monitor_the_web
REDIS_URL=redis://localhost:6379/0

# Snapshots on disk (no MinIO required)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/snapshots

# Fetch defaults
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RESPONSE_BYTES=2000000
HTTP_USER_AGENT=MonitorTheWeb/0.1 (+https://example.com/bot; contact=ops@example.com)

# Email via Resend (https://resend.com)
# Replace re_xxx with your real API key from the Resend dashboard.
# Until you verify your own domain, use: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Auth — leave empty for internal-token dev mode
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# AI (empty LLM_API_KEY = heuristics only)
AI_SUMMARIES_ENABLED=true
LLM_API_KEY=
LLM_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Billing (empty = simulated plan upgrades)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=

# --- Optional later: S3/MinIO instead of local disk ---
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
# S3_BUCKET=monitor-snapshots
