# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=dev-internal-token

# --- Local (no Docker): use localhost ---
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/web_observer
REDIS_URL=redis://localhost:6379/0

# Snapshots on disk (no MinIO required)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/snapshots

# Fetch defaults
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RESPONSE_BYTES=2000000
HTTP_USER_AGENT=MonitorTheWeb/0.1 (+https://example.com/bot; contact=ops@example.com)

# Email via Resend (https://resend.com)
# Replace re_xxx with your real API key from the Resend dashboard.
# Until you verify your own domain, use: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Auth — leave empty for internal-token dev mode
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# AI summaries — optional per-workspace plain-language summaries + per-monitor watch_note triage.
# Works with any OpenAI-compatible API: OpenAI or Vercel AI Gateway.
# Empty LLM_API_KEY = heuristic summaries only; fails open (no triage suppression).
AI_SUMMARIES_ENABLED=true
LLM_API_KEY=
# Examples: OpenAI -> https://api.openai.com/v1 | Vercel AI Gateway -> https://ai-gateway.vercel.sh/v1
LLM_API_BASE=https://api.kilo.ai/api/gateway
LLM_MODEL=tencent/hy3:free
# Comma-separated failover models (server-level). Empty = primary only.
# OpenRouter-style ":free" entries are auto-skipped on first-party OpenAI base.
# LLM_FALLBACK_MODELS=minimax/minimax-m3:free,nvidia/nemotron-3-super:free,google/gemma-4-26b-a4b:free,meta-llama/llama-3.3-70b-instruct:free

# Billing (empty = simulated plan upgrades)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=

# --- Snapshots: local disk (default) OR Cloudflare R2 (S3-compatible, 10GB free) ---
# Local: STORAGE_BACKEND=local (ephemeral on free hosts without a disk)
# R2: STORAGE_BACKEND=s3 + the 4 S3_* vars below. See docs/guides/r2-setup.md.
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY=<R2_TOKEN_ACCESS_KEY_ID>
# S3_SECRET_KEY=<R2_TOKEN_SECRET_ACCESS_KEY>
# S3_BUCKET=monitor-snapshots
# S3_REGION=auto
