# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=dev-internal-token

# --- Local: use localhost ---
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/web_observer
REDIS_URL=redis://localhost:6379/0
# Redis inside WSL2: use the IPv4 literal, not "localhost" — Windows resolves
# "localhost" to ::1 first and WSL2 only forwards IPv4, so each new connection
# stalls ~21 s on the IPv6 attempt. Add the password if requirepass is set:
#   redis://:YOUR_PASSWORD@127.0.0.1:6379/0
# Secondary local instance, no auth, port 8112 (systemd unit: redis-8112):
#   REDIS_URL=redis://127.0.0.1:8112/0

# Snapshots on disk (no MinIO required)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/snapshots

# Fetch defaults
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RESPONSE_BYTES=2000000
HTTP_USER_AGENT=WebObserver/0.1 (+https://example.com/bot; contact=ops@example.com)

# --- CORS allow-list (no wildcards) ---
# The frontend origin(s) allowed to call the API. FRONTEND_URL is merged in.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Canonical public frontend origin, if you have one (e.g. https://app.example.com)
FRONTEND_URL=

# --- Quotas, rate limits and circuit breaking ---
MIN_CHECK_INTERVAL_MINUTES=15
MAX_MONITORS_PER_WORKSPACE=25
MAX_CHECKS_PER_DAY=500
MAX_BROWSER_CHECKS_PER_DAY=50
MAX_NOTIFICATION_DELIVERIES_PER_DAY=200
PER_DOMAIN_RATE_PER_MINUTE=10
PER_DOMAIN_CONCURRENCY=2
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_WINDOW_SECONDS=300
CIRCUIT_OPEN_SECONDS=600
CONSECUTIVE_FAILURE_NOTIFY_THRESHOLD=3

# --- Retention (see docs/local-dev.md §13) ---
SNAPSHOT_RETENTION_DAYS=30
RUN_RETENTION_DAYS=90

# Email via Resend (https://resend.com)
# Replace re_xxx with your real API key from the Resend dashboard.
# Until you verify your own domain, use: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Auth — leave empty for internal-token dev mode
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# AI summaries — optional per-workspace plain-language summaries + per-monitor watch_note triage.
# Two OpenAI-compatible providers are supported. LLM_API_BASE decides which one is
# active and the matching key is picked automatically.
#
#   Kilo Gateway  -> LLM_API_KEY / LLM_MODEL     (free models, $0 input/output)
#   Google Gemini -> GEMINI_API_KEY / GEMINI_MODEL (your own key, metered)
#
# Empty key = heuristic summaries only; fails open (no triage suppression).
AI_SUMMARIES_ENABLED=true
LLM_API_KEY=
# Examples: OpenAI -> https://api.openai.com/v1 | Vercel AI Gateway -> https://ai-gateway.vercel.sh/v1
LLM_API_BASE=https://api.kilo.ai/api/gateway
LLM_MODEL=poolside/laguna-s-2.1:free

# Google Gemini — OpenAI-compatible endpoint. Active when
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# The OS environment wins over this file (pydantic-settings precedence). If a
# GEMINI_API_KEY is also set with `setx` / in your shell profile, the value here
# is ignored — startup logs a warning naming both fingerprints when that happens.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# Free tier: gemini-3.1-flash-lite is the model this project defaults to.
# Check the current free-tier rate limits in the Google AI Studio console
# before raising the poll frequency — *-flash variants are much tighter.
GEMINI_MODEL=gemini-3.1-flash-lite

# Failover models (server-level), tried in order after the primary.
# Empty = the catalog default for the active provider. "none" = primary only.
# Entries naming a different provider than LLM_API_BASE are skipped.
# Empty = catalog default (verified-at-200-tokens models only).
# Free Gemini example: gemini-3.1-flash-lite (keeps failover on Flash-Lite).
LLM_FALLBACK_MODELS=

# AI prompt/response limits and caching
AI_MAX_DIFF_CHARS=6000
AI_MAX_OUTPUT_TOKENS=200
# true = run the LLM in the background worker (ai_enrich) instead of inline,
# which keeps the check fast but delivers the summary a moment later.
AI_ASYNC_ENRICHMENT=false
# Redis dedup TTL for LLM results (per diff fingerprint).
AI_DEDUP_TTL_SECONDS=600

# Scheduler / digest polling
SCHEDULER_POLL_SECONDS=5.0
SCHEDULER_BATCH_SIZE=50
SCHEDULER_JITTER_SECONDS=30
DIGEST_POLL_SECONDS=300.0

# Billing (empty = simulated plan upgrades)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Cloudflare Browser Rendering failover (optional) ---
# Local Playwright stays primary. When a browser fetch fails locally and this
# Worker is set, the check retries once against the edge Worker instead of
# failing. Deployed from workers/browser-failover/ (needs bindings + secret);
# see docs/guides/cloudflare-free-features.md. Empty = feature off.
CLOUDFLARE_BROWSER_URL=
CLOUDFLARE_BROWSER_TOKEN=

SENTRY_DSN=

# --- Visual (screenshot) monitoring ---
# Hamming distance (out of 256 bits) below which two page captures count as
# the same page. The default (8 ≈ 3%) flags a single rewritten headline on a
# real page while staying bit-identical for an unchanged page.
VISUAL_PHASH_THRESHOLD=8
# Legacy aHash threshold (out of 64 bits) — only used for snapshots captured
# before the pHash digest existed.
VISUAL_AHASH_THRESHOLD=5

# --- Snapshots: local disk (default) OR Cloudflare R2 (S3-compatible, 10GB free) ---
# Local: STORAGE_BACKEND=local (ephemeral on free hosts without a disk)
# R2: STORAGE_BACKEND=s3 + the 5 S3_* vars below. See docs/guides/cloudflare-free-features.md §1.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
# Optional: a SECOND, public bucket for screenshots only. Objects whose key
# starts with "screenshots/" are written here instead of S3_BUCKET, so you can
# put a CDN custom domain in front of it and skip the API asset proxy.
# Set the frontend's NEXT_PUBLIC_SCREENSHOT_CDN_URL to the same domain.
S3_SCREENSHOT_BUCKET=

# --- Turnstile (optional) — no public form is wired yet, so this is inert ---
# The widget exists on the Cloudflare account ("web-observer-public-form").
# A key is present but no backend siteverify call is made, and the fetcher
# only *detects* Turnstile challenge markers. Empty = feature off.
TURNSTILE_SITEKEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare URL Scanner (optional security_scan monitor mode) ---
# Free API token with URL Scanner permissions; empty token = mode errors
# clearly at check time.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_URLSCANNER_TOKEN=
