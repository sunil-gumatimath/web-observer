# Application
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=dev-internal-token

# --- Local: use localhost ---
DATABASE_URL=postgresql+psycopg://monitor:monitor@localhost:5432/web_observer
REDIS_URL=redis://localhost:6379/0
# Redis inside WSL2: use the IPv4 literal, not "localhost" — Windows resolves
# "localhost" to ::1 first and WSL2 only forwards IPv4, so each new connection
# stalls ~21 s on the IPv6 attempt. Add the password if requirepass is set:
#   redis://:YOUR_PASSWORD@127.0.0.1:6379/0
# Secondary local instance, no auth, port 8112 (systemd unit: redis-8112):
#   REDIS_URL=redis://127.0.0.1:8112/0

# Snapshots on disk (no MinIO required)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/snapshots

# Fetch defaults
DEFAULT_TIMEOUT_SECONDS=30
DEFAULT_MAX_RESPONSE_BYTES=2000000
HTTP_USER_AGENT=MonitorTheWeb/0.1 (+https://example.com/bot; contact=ops@example.com)

# Email via Resend (https://resend.com)
# Replace re_xxx with your real API key from the Resend dashboard.
# Until you verify your own domain, use: onboarding@resend.dev
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev

# Auth — leave empty for internal-token dev mode
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# AI summaries — optional per-workspace plain-language summaries + per-monitor watch_note triage.
# Two OpenAI-compatible providers are supported. LLM_API_BASE decides which one is
# active and the matching key is picked automatically.
#
#   Kilo Gateway  -> LLM_API_KEY / LLM_MODEL     (free models, $0 input/output)
#   Google Gemini -> GEMINI_API_KEY / GEMINI_MODEL (your own key, metered)
#
# Empty key = heuristic summaries only; fails open (no triage suppression).
AI_SUMMARIES_ENABLED=true
LLM_API_KEY=
# Examples: OpenAI -> https://api.openai.com/v1 | Vercel AI Gateway -> https://ai-gateway.vercel.sh/v1
LLM_API_BASE=https://api.kilo.ai/api/gateway
LLM_MODEL=poolside/laguna-s-2.1:free

# Google Gemini — OpenAI-compatible endpoint. Active when
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_API_KEY=
# The OS environment wins over this file (pydantic-settings precedence). If a
# GEMINI_API_KEY is also set with `setx` / in your shell profile, the value here
# is ignored — startup logs a warning naming both fingerprints when that happens.
GEMINI_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# Free tier: gemini-3.5-flash-lite = 10 RPM / 250k TPM / 500 RPD.
# Avoid *-flash on a free key (5 RPM / 20 RPD) and Pro models (paid only).
GEMINI_MODEL=gemini-3.5-flash-lite

# Failover models (server-level), tried in order after the primary.
# Empty = the catalog default for the active provider. "none" = primary only.
# Entries naming a different provider than LLM_API_BASE are skipped.
# Empty = catalog default (verified-at-200-tokens models only).
# Free Gemini example: gemini-3.1-flash-lite (keeps failover on Flash-Lite).
LLM_FALLBACK_MODELS=

# Billing (empty = simulated plan upgrades)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SENTRY_DSN=

# --- Snapshots: local disk (default) OR Cloudflare R2 (S3-compatible, 10GB free) ---
# Local: STORAGE_BACKEND=local (ephemeral on free hosts without a disk)
# R2: STORAGE_BACKEND=s3 + the 5 S3_* vars below. See docs/guides/r2-setup.md.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=
