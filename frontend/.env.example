# Frontend environment variables (Next.js App Router).
#
# Copy to frontend/.env.local and fill in real values; .env.local is
# git-ignored, so never commit secrets. Backend variables are documented in the
# repo-root .env.example and in README.md "Env files".
#
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time —
# never put a secret in a NEXT_PUBLIC_ key.

# MUST match the API port you start (8000 or 8002).
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002

# Internal-token dev mode only. Leave unset when Clerk is enabled.
NEXT_PUBLIC_INTERNAL_API_TOKEN=dev-internal-token

# Clerk: the publishable key is public; the secret key is server-side only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Clerk JWT clock tolerance in milliseconds (default 60000 = 60 s). Read by
# frontend/src/proxy.ts:19 and passed to clerkMiddleware as clockSkewInMs.
# Raise it only if this machine's clock drifts from Clerk and tokens are
# rejected as expired/immediately-valid.
# CLERK_CLOCK_SKEW_MS=60000

# Optional: preselect a dev/seed workspace in the UI (internal-token mode only).
# NEXT_PUBLIC_DEV_WORKSPACE_ID=

# Optional Cloudflare Web Analytics beacon (empty = beacon never loads).
# NEXT_PUBLIC_CF_BEACON_TOKEN=

# Optional: serve screenshots from a public R2 bucket CDN instead of the API
# proxy. Must match the custom domain bound to the backend S3_SCREENSHOT_BUCKET.
# NEXT_PUBLIC_SCREENSHOT_CDN_URL=https://screenshots.example.com
