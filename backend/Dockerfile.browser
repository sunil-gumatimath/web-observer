# Browser worker image with Playwright Chromium
# noble (Ubuntu 24.04) ships Python 3.12 — required for enum.StrEnum (3.11+).
# Keep image minor in sync with pip playwright (requirements: playwright>=1.49,<2).
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN useradd -m appuser 2>/dev/null || true; chown -R appuser:appuser /app || true
# Playwright image runs as root by default; keep root for browser sandbox but
# drop to appuser if you run with --user. No HEALTHCHECK here — compose handles it.

# Dramatiq worker listening only to browser_checks queue
CMD ["dramatiq", "app.workers", "--queues", "browser_checks", "--processes", "1", "--threads", "1"]
